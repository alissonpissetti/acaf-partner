# Dev: deixe VITE_API_URL vazio — o browser chama /api e o Vite faz proxy (sem CORS).
# VITE_API_URL=

# Só no `vite dev`: destino do proxy /api e /shared (padrão http://127.0.0.1:8787).
# Use outra porta só se a API estiver escutando nela (ex.: conflito na 8787).
# VITE_API_PROXY_TARGET=http://127.0.0.1:8787

# Produção Coolify — variável OBRIGATÓRIA no serviço partner (runtime):
# API_BACKEND_URL=http://ucskoskgsgcswk0sock84sg4.76.13.66.204.sslip.io
# Porta 80 (sem :8787). O nginx faz proxy de /api → API_BACKEND_URL.

# Opcional: CONNECT_API_DIRECT=1 para URL absoluta no browser
